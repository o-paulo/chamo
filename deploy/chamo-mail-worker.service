[Unit]
Description=Chamô mail queue worker
After=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/chamo
EnvironmentFile=/etc/chamo/chamo.env
ExecStart=/usr/bin/php /var/www/chamo/scripts/mail-worker.php
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/chamo
