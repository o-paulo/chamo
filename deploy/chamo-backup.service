[Unit]
Description=Create Chamô database and attachment backup

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/chamo
EnvironmentFile=/etc/chamo/chamo.env
ExecStart=/usr/bin/php /var/www/chamo/scripts/backup.php
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/chamo /var/backups/chamo
